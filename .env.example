# Reown / WalletConnect project ID — required for wallet connectivity.
# Create a project at https://cloud.reown.com and copy its Project ID here.
# Copy this file to .env.local and fill in the value.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Optional: remote JSON sources for the navigation and footer menus.
# Defaults to Lightchain's hosted config. Override to point at your own,
# or leave commented out to use the defaults. If a config is unreachable,
# the menu simply renders empty instead of crashing.
# NEXT_PUBLIC_NAV_CONFIG_URL=https://docs.lightchain.ai/nav-config.json
# NEXT_PUBLIC_FOOTER_CONFIG_URL=https://docs.lightchain.ai/footer-config.json
